# ─────────────────────────────────────────────────────────────────────────
# Backend NDIMB S.A — configuration d'environnement
# Copiez ce fichier en ".env" (dans le même dossier) puis renseignez vos
# propres valeurs. Le fichier ".env" ne doit JAMAIS être partagé ni versionné
# (il est déjà exclu via .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# Clé secrète Django. Générez-en une à vous avant la mise en production :
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-moi-avec-une-vraie-cle-secrete

# True en développement uniquement. Mettre False en production.
DEBUG=True

# Domaines/IP autorisés à servir l'API, séparés par des virgules.
ALLOWED_HOSTS=127.0.0.1,localhost

# Origines autorisées à appeler l'API (là où le site statique est servi),
# séparées par des virgules. Ajoutez votre domaine réel en production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080

# Fuseau horaire du backend.
DJANGO_TIME_ZONE=Africa/Dakar

# ─────────────────────────────────────────────────────────────────────────
# Envoi d'e-mail (formulaire de contact)
# ─────────────────────────────────────────────────────────────────────────

# Adresse qui RECEVRA les messages envoyés depuis le formulaire de contact
# du site. C'est la variable demandée : mettez ici votre e-mail.
CONTACT_RECIPIENT_EMAIL=votre-adresse@exemple.com

# Paramètres SMTP utilisés pour ENVOYER ces e-mails.
# Exemple avec un compte Gmail : activez la validation en deux étapes puis
# créez un "mot de passe d'application" (https://myaccount.google.com/apppasswords).
# Tant que EMAIL_HOST_USER / EMAIL_HOST_PASSWORD ne sont pas renseignés, les
# e-mails s'affichent simplement dans la console (aucun envoi réel).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-compte-envoi@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=Site NDIMB S.A <votre-compte-envoi@gmail.com>
